{
    "compilerOptions": {
        "target": "es5",
        "baseUrl": ".",
        "paths": {
            "@brightlayer-ui/icons-mui": ["../../packages/mui/tsx/index.ts"],
            "@brightlayer-ui/icons-mui/index.json": ["../../packages/mui/index.json"]
        },
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "module": "esnext",
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx"
    },
    "include": ["src"]
}
